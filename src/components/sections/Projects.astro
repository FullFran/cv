---
import Section from "../Section.astro";
import ProjectItem from "../ProjectItem.astro";
import type { CVData, Locale } from "@lib/cv";
import { labels } from "@lib/cv";

interface Props {
  data: CVData;
  lang: Locale;
  /** How many projects stay visible; the rest go inside a "show more" toggle. */
  visibleProjects?: number;
}

const { data, lang, visibleProjects = 4 } = Astro.props;
const t = labels[lang];
const projects = data.projects ?? [];
const shown = projects.slice(0, visibleProjects);
const hidden = projects.slice(visibleProjects);
---

{
  projects.length > 0 && (
    <Section title={t.projects}>
      <ul class="flex flex-col gap-3">
        {shown.map((proj) => (
          <ProjectItem
            name={proj.name}
            description={proj.description}
            url={proj.url}
            keywords={proj.keywords}
          />
        ))}
      </ul>

      {hidden.length > 0 && (
        <details class="group mt-2" data-cv-more>
          <summary class="cursor-pointer list-none text-[11.5px] font-medium text-blue-800 hover:underline">
            <span class="group-open:hidden">
              + {t.showMore} ({hidden.length})
            </span>
            <span class="hidden group-open:inline">- {t.showLess}</span>
          </summary>
          <ul class="mt-3 flex flex-col gap-3">
            {hidden.map((proj) => (
              <ProjectItem
                name={proj.name}
                description={proj.description}
                url={proj.url}
                keywords={proj.keywords}
              />
            ))}
          </ul>
        </details>
      )}
    </Section>
  )
}
